// Prisma schema for Raika Game Platform
// Supports both PostgreSQL (production) and SQLite (instant zero-dependency dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Set to "postgresql" for production deployment
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  telegramId    String         @unique
  username      String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  balance       Float          @default(0.00)
  demoBalance   Float          @default(10000.00)
  totalWagered  Float          @default(0.00)
  totalWon      Float          @default(0.00)
  activeWagers  Float          @default(0.00)
  vipTier       String         @default("Bronze I")
  lastClaimDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transactions  Transaction[]
  gameSessions  GameSession[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "DEPOSIT", "WITHDRAW", "BET", "WIN", "BONUS", "DAILY_CLAIM"
  amount      Float
  currency    String   @default("USD")
  status      String   @default("COMPLETED") // "COMPLETED", "PENDING", "REJECTED"
  txHash      String?
  description String?
  createdAt   DateTime @default(now())
}

model GameSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType       String   @default("chicken_shoot") // "chicken_shoot", "mines", "plinko", "wheel"
  betAmount      Float
  multiplier     Float
  payout         Float
  isDemo         Boolean  @default(false)
  outcomeDetails String?  // JSON stringified details (e.g., target hit, random seed, serverHash)
  createdAt      DateTime @default(now())
}

model GameStats {
  id             String   @id @default("global")
  onlinePlayers  Int      @default(7988)
  totalBetsCount Int      @default(154200)
  totalVolume    Float    @default(895420.50)
  updatedAt      DateTime @updatedAt
}
